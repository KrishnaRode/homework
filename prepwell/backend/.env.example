# PrepWell backend configuration. Copy to .env to override defaults.

# Ollama
OLLAMA_HOST=http://localhost:11434
PREPWELL_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=120

# Server
PREPWELL_HOST=0.0.0.0
PREPWELL_PORT=8000
PREPWELL_SECRET=change-me-locally-only

# Session
MAX_QUESTIONS_PER_SESSION=500

# Demo admin (seeded on first run if no admin exists)
PREPWELL_ADMIN_USER=admin
PREPWELL_ADMIN_PASSWORD=prepwell123
